#!/usr/bin/env python3

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

from tools.session_manager import SessionManager

from tools.view_qc import (
    evaluate_view,
    update_view_manifest,
    update_session_manifest,
)

from tools.remote_tx_controller import RemoteTXController

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML is not installed.")
    print("Install with:")
    print("  sudo apt install python3-yaml")
    sys.exit(2)


ROOT = Path(__file__).resolve().parent

CONFIG_DIR = ROOT / "configs" / "platform"

CONFIG_FILES = {
    "system": CONFIG_DIR / "system.yaml",
    "geometry": CONFIG_DIR / "geometry.yaml",
    "acquisition": CONFIG_DIR / "acquisition.yaml",
    "calibration": CONFIG_DIR / "calibration.yaml",
}


def load_yaml(path):
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def print_header():
    print("=" * 62)
    print("USRP B210 MIMO-CSI SENSING PLATFORM")
    print("=" * 62)


def check_file(label, path):
    ok = path.exists()

    print(
        f"{label:<28}",
        "PASS" if ok else "FAIL",
        str(path.relative_to(ROOT))
    )

    return ok


def command_exists(name):
    return shutil.which(name) is not None


def doctor():
    print_header()

    print()
    print("[CONFIGURATION]")

    config_ok = True

    configs = {}

    for name, path in CONFIG_FILES.items():
        ok = check_file(
            name,
            path
        )

        config_ok &= ok

        if ok:
            try:
                configs[name] = load_yaml(path)
            except Exception as e:
                print(
                    f"  YAML ERROR {name}:",
                    e
                )
                config_ok = False

    print()
    print("[SOFTWARE]")

    tools = [
        "python3",
        "uhd_find_devices",
        "uhd_usrp_probe",
    ]

    software_ok = True

    for tool in tools:
        ok = command_exists(tool)

        print(
            f"{tool:<28}",
            "PASS" if ok else "FAIL"
        )

        software_ok &= ok

    print()
    print("[USRP]")

    usrp_ok = False

    if command_exists(
        "uhd_find_devices"
    ):
        try:
            result = subprocess.run(
                [
                    "uhd_find_devices",
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                timeout=15,
            )

            text = result.stdout

            if (
                "B210" in text
                or "B200" in text
                or "product: B210" in text
            ):
                usrp_ok = True

        except Exception as e:
            print(
                "USRP check error:",
                e
            )

    print(
        f"{'USRP B210 detected':<28}",
        "PASS" if usrp_ok else "FAIL"
    )

    print()
    print("[CALIBRATION]")

    calibration_ok = False

    if "calibration" in configs:

        c = configs[
            "calibration"
        ][
            "active_profile"
        ]

        ref_file = (
            ROOT
            / c["reference"][
                "calibration_file"
            ]
        )

        bg_file = (
            ROOT
            / c["background"][
                "model_file"
            ]
        )

        ref_ok = ref_file.exists()
        bg_ok = bg_file.exists()

        print(
            f"{'reference calibration':<28}",
            "PASS" if ref_ok else "FAIL"
        )

        print(
            f"{'background model':<28}",
            "PASS" if bg_ok else "FAIL"
        )

        calibration_ok = (
            ref_ok
            and bg_ok
        )

    print()
    print("[GEOMETRY]")

    geometry_ready = False

    if "geometry" in configs:

        g = configs["geometry"]

        geometry_ready = bool(
            g.get(
                "geometry_status",
                {}
            ).get(
                "ready_for_absolute_spatial_processing",
                False
            )
        )

    print(
        f"{'absolute spatial geometry':<28}",
        (
            "PASS"
            if geometry_ready
            else "NOT CONFIGURED"
        )
    )

    print()
    print("[SUMMARY]")

    acquisition_ready = (
        config_ok
        and software_ok
        and usrp_ok
        and calibration_ok
    )

    print(
        "CSI acquisition backend :",
        (
            "READY"
            if acquisition_ready
            else "NOT READY"
        )
    )

    print(
        "Spatial reconstruction  :",
        (
            "READY"
            if geometry_ready
            else "BLOCKED BY GEOMETRY"
        )
    )

    if acquisition_ready:
        print()
        print(
            "Platform configuration layer: PASS"
        )

    return 0 if acquisition_ready else 1


def show_config():
    print_header()

    for name, path in CONFIG_FILES.items():

        print()
        print(
            f"[{name.upper()}]"
        )

        if not path.exists():
            print("MISSING")
            continue

        data = load_yaml(path)

        print(
            yaml.safe_dump(
                data,
                sort_keys=False,
                allow_unicode=True
            )
        )


def status():
    print_header()

    system = load_yaml(
        CONFIG_FILES["system"]
    )

    calibration = load_yaml(
        CONFIG_FILES["calibration"]
    )

    geometry = load_yaml(
        CONFIG_FILES["geometry"]
    )

    rf = system["rf"]

    print(
        "Platform      :",
        system["platform"]["name"]
    )

    print(
        "RF frequency  :",
        f'{rf["center_frequency_hz"]/1e9:.3f} GHz'
    )

    print(
        "Sample rate   :",
        f'{rf["sample_rate_hz"]/1e6:.3f} MHz'
    )

    print(
        "MIMO mode     :",
        system["mimo"]["mode"]
    )

    print(
        "CSI carriers  :",
        rf["active_subcarriers"]
    )

    print(
        "Calibration   :",
        calibration[
            "active_profile"
        ]["id"]
    )

    print(
        "Geometry      :",
        (
            "READY"
            if geometry[
                "geometry_status"
            ][
                "ready_for_absolute_spatial_processing"
            ]
            else "NOT CONFIGURED"
        )
    )




def run_rx_backend(
    view_dir,
    duration_s,
    snr_min,
    dry_run=False,
):
    backend = (
        ROOT
        / "scripts"
        / "run_rx_tdm_view.sh"
    )

    if not backend.exists():
        raise RuntimeError(
            f"RX backend not found: {backend}"
        )

    csi_dir = (
        Path(view_dir)
        / "csi"
    )

    cmd = [
        str(backend),
        "--output",
        str(csi_dir),
        "--duration",
        str(duration_s),
        "--snr-min",
        str(snr_min),
    ]

    if dry_run:
        cmd.append("--dry-run")

    print()
    print("[RX BACKEND]")
    print(
        "Command      :",
        " ".join(cmd)
    )

    result = subprocess.run(
        cmd,
        cwd=ROOT,
    )

    return result.returncode



def prepare_capture(
    session_name,
    mode="step",
    trajectory="manual_step",
):
    print_header()

    print()
    print("[SESSION PREPARATION]")

    manager = SessionManager(ROOT)

    session_dir = manager.create_session(
        session_name,
        mode=mode,
        trajectory=trajectory,
    )

    view_dir = (
        session_dir
        / "views"
        / "view_000"
    )

    print(
        "Session name :",
        session_name
    )

    print(
        "Mode         :",
        mode
    )

    print(
        "Trajectory   :",
        trajectory
    )

    print(
        "Session dir  :",
        session_dir
    )

    print(
        "Initial view :",
        view_dir
    )

    print()
    print(
        "Session state: PREPARED"
    )

    print()
    print(
        "RF acquisition has NOT been started."
    )

    print(
        "This command currently validates the "
        "session/dataset orchestration layer only."
    )

    return 0



def capture_session(
    session_name,
    mode="step",
    trajectory="manual_step",
    duration_s=None,
    snr_min=10.0,
    dry_run=False,
    remote_tx=True,
    tx_interval_ms=100,
):
    print_header()

    acquisition = load_yaml(
        CONFIG_FILES["acquisition"]
    )

    if duration_s is None:
        duration_s = acquisition[
            "capture"
        ][
            "duration_s"
        ]

    manager = SessionManager(ROOT)

    session_dir = manager.create_session(
        session_name,
        mode=mode,
        trajectory=trajectory,
    )

    view_dir = (
        session_dir
        / "views"
        / "view_000"
    )

    print()
    print("[CAPTURE SESSION]")

    print(
        "Session      :",
        session_dir
    )

    print(
        "View         :",
        view_dir
    )

    print(
        "Mode         :",
        mode
    )

    print(
        "Duration     :",
        duration_s,
        "s"
    )

    print(
        "SNR minimum  :",
        snr_min,
        "dB"
    )

    print(
        "Dry run      :",
        dry_run
    )

    tx = None
    tx_started = False

    try:

        if remote_tx and not dry_run:

            print()
            print("[REMOTE TX]")

            tx = RemoteTXController(
                interval_ms=tx_interval_ms
            )

            if not tx.check_connection():
                print(
                    "Remote TX SSH : FAIL"
                )
                return 6

            print(
                "Remote TX SSH : PASS"
            )

            current = tx.status()

            if current["running"]:
                print(
                    "Remote TX     : ALREADY RUNNING"
                )
                print(
                    "PID           :",
                    current["pid"]
                )
                return 7

            print(
                "Starting TX    :",
                f"{tx_interval_ms} ms"
            )

            state = tx.start()

            tx_started = True

            print(
                "Remote TX     : RUNNING"
            )

            print(
                "PID           :",
                state["pid"]
            )

        status = run_rx_backend(
            view_dir=view_dir,
            duration_s=duration_s,
            snr_min=snr_min,
            dry_run=dry_run,
        )

        if status != 0:
            print()
            print(
                "Capture backend: FAIL"
            )
            return status

    finally:

        if tx is not None and tx_started:

            print()
            print("[REMOTE TX SHUTDOWN]")

            try:
                result = tx.stop()

                print(
                    "Remote TX     :",
                    "STOPPED"
                    if result["stopped"]
                    else "STOP FAILED"
                )

            except Exception as exc:

                print(
                    "Remote TX stop error:",
                    exc
                )

    print()
    print(
        "Capture backend:",
        "DRY-RUN PASS"
        if dry_run
        else "PASS"
    )

    if dry_run:
        print(
            "Session:",
            session_dir
        )
        return 0

    print()
    print("[VIEW QUALITY CONTROL]")

    qc = evaluate_view(
        ROOT,
        view_dir,
    )

    update_view_manifest(
        view_dir,
        qc,
    )

    update_session_manifest(
        session_dir,
        "view_000",
        qc,
    )

    print(
        "TDM cycles    :",
        qc[
            "complete_tdm_cycles"
        ]
    )

    print(
        "Minimum       :",
        qc[
            "minimum_complete_tdm_cycles"
        ]
    )

    print(
        "Tensor shape  :",
        qc[
            "tensor_shape"
        ]
    )

    print(
        "TX mapping    :",
        "PASS"
        if qc[
            "physical_tx_mapping_valid"
        ]
        else "FAIL"
    )

    print(
        "Finite CSI    :",
        "PASS"
        if qc[
            "all_links_finite"
        ]
        else "FAIL"
    )

    print()

    if qc["accepted"]:
        print(
            "VIEW QUALITY : ACCEPTED"
        )
        print(
            "Reason       : accepted"
        )
    else:
        print(
            "VIEW QUALITY : REJECTED"
        )
        print(
            "Reason       :",
            qc["reason"]
        )

    print()

    print(
        "Session:",
        session_dir
    )

    #
    # Run validated post-processing only for an accepted view.
    #
    if qc["accepted"]:

        run_view_feature_pipeline(
            view_dir
        )

    #
    # Important:
    # backend succeeded even if scientific QC rejected the view.
    # Use exit code 3 to distinguish this state.
    #
    return 0 if qc["accepted"] else 3



def run_view_feature_pipeline(
    view_dir,
):
    runner = (
        ROOT
        / "tools"
        / "run_view_feature_pipeline.py"
    )

    if not runner.exists():

        print()
        print(
            "[FEATURE EXTRACTION]"
        )

        print(
            "Feature runner: SKIP"
        )

        print(
            "Reason: runner not installed"
        )

        return None

    print()
    print(
        "[FEATURE EXTRACTION]"
    )

    result = subprocess.run(
        [
            sys.executable,
            str(runner),
            str(view_dir),
        ],
        cwd=ROOT,
    )

    if result.returncode == 0:

        print()
        print(
            "Feature pipeline: PASS"
        )

        return True

    print()
    print(
        "Feature pipeline: WARNING"
    )

    print(
        "RF acquisition remains valid; "
        "one or more post-processing "
        "features failed."
    )

    return False


def main():

    parser = argparse.ArgumentParser(
        prog="csi-sense",
        description=(
            "USRP B210 2x2 MIMO-CSI "
            "communication and sensing framework"
        ),
    )

    sub = parser.add_subparsers(
        dest="command",
        required=True,
    )

    sub.add_parser(
        "doctor",
        help="Check hardware, configs and calibration.",
    )

    sub.add_parser(
        "status",
        help="Show active platform status.",
    )

    sub.add_parser(
        "config",
        help="Show unified configuration.",
    )

    capture_parser = sub.add_parser(
        "capture",
        help="Prepare or run a CSI sensing capture session.",
    )

    capture_parser.add_argument(
        "session_name",
        help="Logical experiment/session name, e.g. room01.",
    )

    capture_parser.add_argument(
        "--prepare",
        action="store_true",
        help="Prepare session and initial view without RF acquisition.",
    )

    capture_parser.add_argument(
        "--mode",
        choices=["step", "continuous"],
        default="step",
        help="Acquisition mode. Default: step.",
    )

    capture_parser.add_argument(
        "--trajectory",
        default="manual_step",
        help="Trajectory config name. Default: manual_step.",
    )

    capture_parser.add_argument(
        "--duration",
        type=float,
        default=None,
        help="Capture duration in seconds. Default from acquisition.yaml.",
    )

    capture_parser.add_argument(
        "--snr-min",
        type=float,
        default=10.0,
        help="Minimum CSI SNR for TDM tensor construction.",
    )

    capture_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Run complete orchestration without starting RF acquisition.",
    )

    capture_parser.add_argument(
        "--no-remote-tx",
        action="store_true",
        help="Do not start/stop TX remotely. Use an externally managed TX.",
    )

    capture_parser.add_argument(
        "--tx-interval-ms",
        type=int,
        default=100,
        help="Remote TX packet interval in ms. Default: 100.",
    )

    args = parser.parse_args()

    if args.command == "doctor":
        sys.exit(doctor())

    if args.command == "status":
        status()
        return

    if args.command == "config":
        show_config()
        return

    if args.command == "capture":

        if args.prepare:
            sys.exit(
                prepare_capture(
                    args.session_name,
                    mode=args.mode,
                    trajectory=args.trajectory,
                )
            )

        sys.exit(
            capture_session(
                args.session_name,
                mode=args.mode,
                trajectory=args.trajectory,
                duration_s=args.duration,
                snr_min=args.snr_min,
                dry_run=args.dry_run,
                remote_tx=not args.no_remote_tx,
                tx_interval_ms=args.tx_interval_ms,
            )
        )


if __name__ == "__main__":
    main()
