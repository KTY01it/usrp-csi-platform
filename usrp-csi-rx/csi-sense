def capture_view(
    session_dir,
    view_dir,
    duration_s,
    snr_min=10.0,
    dry_run=False,
    remote_tx=True,
    tx_interval_ms=100,
):
    session_dir = Path(
        session_dir
    ).resolve()

    view_dir = Path(
        view_dir
    ).resolve()

    if not view_dir.exists():
        print(
            "ERROR: view directory does not exist:"
        )
        print(
            view_dir
        )
        return 2

    view_id = view_dir.name

    print()
    print("[CAPTURE VIEW]")

    print(
        "Session      :",
        session_dir
    )

    print(
        "View         :",
        view_id
    )

    print(
        "View dir     :",
        view_dir
    )

    print(
        "Duration     :",
        duration_s,
        "s"
    )

    print(
        "SNR minimum  :",
        snr_min,
        "dB"
    )

    print(
        "Dry run      :",
        dry_run
    )

    tx = None
    tx_started = False

    try:

        if remote_tx and not dry_run:

            print()
            print("[REMOTE TX]")

            tx = RemoteTXController(
                interval_ms=tx_interval_ms
            )

            if not tx.check_connection():

                print(
                    "Remote TX SSH : FAIL"
                )

                return 6

            print(
                "Remote TX SSH : PASS"
            )

            current = tx.status()

            if current["running"]:

                print(
                    "Remote TX     : ALREADY RUNNING"
                )

                print(
                    "PID           :",
                    current["pid"]
                )

                return 7

            print(
                "Starting TX    :",
                f"{tx_interval_ms} ms"
            )

            state = tx.start()

            tx_started = True

            print(
                "Remote TX     : RUNNING"
            )

            print(
                "PID           :",
                state["pid"]
            )

        status = run_rx_backend(
            view_dir=view_dir,
            duration_s=duration_s,
            snr_min=snr_min,
            dry_run=dry_run,
        )

        if status != 0:

            print()
            print(
                "Capture backend: FAIL"
            )

            return status

    finally:

        if tx is not None and tx_started:

            print()
            print("[REMOTE TX SHUTDOWN]")

            try:

                result = tx.stop()

                print(
                    "Remote TX     :",
                    "STOPPED"
                    if result["stopped"]
                    else "STOP FAILED"
                )

            except Exception as exc:

                print(
                    "Remote TX stop error:",
                    exc
                )

    print()

    print(
        "Capture backend:",
        "DRY-RUN PASS"
        if dry_run
        else "PASS"
    )

    if dry_run:

        print(
            "Session:",
            session_dir
        )

        print(
            "View:",
            view_id
        )

        return 0

    print()
    print(
        "[VIEW QUALITY CONTROL]"
    )

    qc = evaluate_view(
        ROOT,
        view_dir,
    )

    update_view_manifest(
        view_dir,
        qc,
    )

    update_session_manifest(
        session_dir,
        view_id,
        qc,
    )

    print(
        "TDM cycles    :",
        qc[
            "complete_tdm_cycles"
        ]
    )

    print(
        "Minimum       :",
        qc[
            "minimum_complete_tdm_cycles"
        ]
    )

    print(
        "Tensor shape  :",
        qc[
            "tensor_shape"
        ]
    )

    print(
        "TX mapping    :",
        "PASS"
        if qc[
            "physical_tx_mapping_valid"
        ]
        else "FAIL"
    )

    print(
        "Finite CSI    :",
        "PASS"
        if qc[
            "all_links_finite"
        ]
        else "FAIL"
    )

    print()

    if qc["accepted"]:

        print(
            "VIEW QUALITY : ACCEPTED"
        )

        print(
            "Reason       : accepted"
        )

    else:

        print(
            "VIEW QUALITY : REJECTED"
        )

        print(
            "Reason       :",
            qc["reason"]
        )

    print()

    print(
        "Session:",
        session_dir
    )

    print(
        "View:",
        view_id
    )

    #
    # Run validated post-processing only
    # for an accepted view.
    #
    if qc["accepted"]:

        run_view_feature_pipeline(
            view_dir
        )

    #
    # Backend succeeded even if scientific
    # QC rejected the view.
    #
    return 0 if qc["accepted"] else 3



