def run_rx_backend(
    view_dir,
    duration_s,
    snr_min,
    dry_run=False,
):
    backend = (
        ROOT
        / "scripts"
        / "run_rx_tdm_view.sh"
    )

    if not backend.exists():
        raise RuntimeError(
            f"RX backend not found: {backend}"
        )

    csi_dir = (
        Path(view_dir)
        / "csi"
    )

    cmd = [
        str(backend),
        "--output",
        str(csi_dir),
        "--duration",
        str(duration_s),
        "--snr-min",
        str(snr_min),
    ]

    if dry_run:
        cmd.append("--dry-run")

    print()
    print("[RX BACKEND]")
    print(
        "Command      :",
        " ".join(cmd)
    )

    result = subprocess.run(
        cmd,
        cwd=ROOT,
    )

    return result.returncode



