class ScanPoseCancelled(Exception):
    pass


def prompt_float(
    label,
    default=None,
):
    while True:

        if default is None:
            text = input(
                f"{label}: "
            ).strip()
        else:
            text = input(
                f"{label} [{default}]: "
            ).strip()

            if text == "":
                return float(
                    default
                )

        if text.lower() in (
            "q",
            "quit",
            "exit",
        ):
            raise ScanPoseCancelled()

        try:
            return float(
                text
            )

        except ValueError:
            print(
                "Invalid number. Try again."
            )


def prompt_xyz(
    label,
):
    print()
    print(
        f"{label} position [m]"
    )

    x = prompt_float(
        "  x"
    )

    y = prompt_float(
        "  y"
    )

    z = prompt_float(
        "  z"
    )

    return [
        x,
        y,
        z,
    ]


def prompt_orientation(
    label,
):
    print()
    print(
        f"{label} orientation [deg]"
    )

    yaw = prompt_float(
        "  yaw",
        0.0,
    )

    pitch = prompt_float(
        "  pitch",
        0.0,
    )

    roll = prompt_float(
        "  roll",
        0.0,
    )

    return (
        yaw,
        pitch,
        roll,
    )


