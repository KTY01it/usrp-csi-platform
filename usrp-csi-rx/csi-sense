def scan_session(
    session_name,
    trajectory="manual_step",
    duration_s=None,
    snr_min=10.0,
    dry_run=False,
    remote_tx=True,
    tx_interval_ms=100,
):
    print_header()

    acquisition = load_yaml(
        CONFIG_FILES["acquisition"]
    )

    if duration_s is None:

        duration_s = acquisition[
            "capture"
        ][
            "duration_s"
        ]

    manager = SessionManager(
        ROOT
    )

    session_dir = manager.create_session(
        session_name,
        mode="step",
        trajectory=trajectory,
    )

    view_dir = (
        session_dir
        / "views"
        / "view_000"
    )

    print()
    print(
        "=" * 62
    )
    print(
        "MULTI-VIEW MANUAL STEP SCAN"
    )
    print(
        "=" * 62
    )

    print(
        "Session:",
        session_dir
    )

    print(
        "Trajectory:",
        trajectory
    )

    print(
        "Duration/view:",
        duration_s,
        "s"
    )

    print(
        "SNR minimum:",
        snr_min,
        "dB"
    )

    print(
        "TX interval:",
        tx_interval_ms,
        "ms"
    )

    print(
        "Dry run:",
        dry_run
    )

    accepted_views = 0
    rejected_views = 0
    dryrun_views = 0
    view_index = 0

    while True:

        print()
        print(
            "#" * 62
        )

        print(
            f"VIEW {view_index:03d}"
        )

        print(
            "#" * 62
        )

        try:

            register_view_pose_interactive(
                manager,
                view_dir,
            )

        except ScanPoseCancelled:

            print()
            print(
                "Pose entry cancelled."
            )

            print(
                "Removing uncaptured prepared view:",
                view_dir.name,
            )

            manager.remove_prepared_view(
                session_dir,
                view_dir,
            )

            break

        print()
        print(
            "Pose registered."
        )

        print(
            "Place both platforms exactly at the "
            "registered pose before capture."
        )

        command = input(
            "Press Enter to capture, "
            "'q' to finish without capturing this view: "
        ).strip().lower()

        if command in (
            "q",
            "quit",
            "exit",
        ):

            print()
            print(
                "Current prepared view not captured."
            )

            break

        status = capture_view(
            session_dir=session_dir,
            view_dir=view_dir,
            duration_s=duration_s,
            snr_min=snr_min,
            dry_run=dry_run,
            remote_tx=remote_tx,
            tx_interval_ms=tx_interval_ms,
        )

        if status == 0:

            if dry_run:

                dryrun_views += 1

                print()
                print(
                    f"{view_dir.name}: DRY-RUN PASS"
                )

            else:

                accepted_views += 1

                print()
                print(
                    f"{view_dir.name}: PASS"
                )

        elif status == 3:

            rejected_views += 1

            print()
            print(
                f"{view_dir.name}: "
                "SCIENTIFIC QC REJECTED"
            )

        else:

            print()
            print(
                f"{view_dir.name}: "
                f"CAPTURE ERROR ({status})"
            )

            print(
                "Scan stopped to avoid "
                "geometry/data misalignment."
            )

            return status

        print()

        command = input(
            "Next view? "
            "[Enter=yes, q=finish]: "
        ).strip().lower()

        if command in (
            "q",
            "quit",
            "exit",
        ):

            break

        view_dir = manager.create_next_view(
            session_dir,
            state="prepared",
        )

        view_index += 1

    print()
    print(
        "=" * 62
    )

    print(
        "SCAN COMPLETE"
    )

    print(
        "=" * 62
    )

    print(
        "Session:",
        session_dir
    )

    print(
        "Accepted views:",
        accepted_views
    )

    print(
        "Rejected views:",
        rejected_views
    )

    print(
        "Dry-run views:",
        dryrun_views
    )

    print(
        "Registered views remaining:",
        accepted_views
        + rejected_views
        + dryrun_views
    )

    print()
    print(
        "Multi-view reconstruction remains "
        "conditional on correct manual pose "
        "registration and future spatial fusion."
    )

    return 0


def run_view_feature_pipeline(
    view_dir,
):
    runner = (
        ROOT
        / "tools"
        / "run_view_feature_pipeline.py"
    )

    if not runner.exists():

        print()
        print(
            "[FEATURE EXTRACTION]"
        )

        print(
            "Feature runner: SKIP"
        )

        print(
            "Reason: runner not installed"
        )

        return None

    print()
    print(
        "[FEATURE EXTRACTION]"
    )

    result = subprocess.run(
        [
            sys.executable,
            str(runner),
            str(view_dir),
        ],
        cwd=ROOT,
    )

    if result.returncode == 0:

        print()
        print(
            "Feature pipeline: PASS"
        )

        return True

    print()
    print(
        "Feature pipeline: WARNING"
    )

    print(
        "RF acquisition remains valid; "
        "one or more post-processing "
        "features failed."
    )

    return False


def main():

    parser = argparse.ArgumentParser(
        prog="csi-sense",
        description=(
            "USRP B210 2x2 MIMO-CSI "
            "communication and sensing framework"
        ),
    )

    sub = parser.add_subparsers(
        dest="command",
        required=True,
    )

    sub.add_parser(
        "doctor",
        help="Check hardware, configs and calibration.",
    )

    sub.add_parser(
        "status",
        help="Show active platform status.",
    )

    sub.add_parser(
        "config",
        help="Show unified configuration.",
    )

    capture_parser = sub.add_parser(
        "capture",
        help="Prepare or run a CSI sensing capture session.",
    )

    capture_parser.add_argument(
        "session_name",
        help="Logical experiment/session name, e.g. room01.",
    )

    capture_parser.add_argument(
        "--prepare",
        action="store_true",
        help="Prepare session and initial view without RF acquisition.",
    )

    capture_parser.add_argument(
        "--mode",
        choices=["step", "continuous"],
        default="step",
        help="Acquisition mode. Default: step.",
    )

    capture_parser.add_argument(
        "--trajectory",
        default="manual_step",
        help="Trajectory config name. Default: manual_step.",
    )

    capture_parser.add_argument(
        "--duration",
        type=float,
        default=None,
        help="Capture duration in seconds. Default from acquisition.yaml.",
    )

    capture_parser.add_argument(
        "--snr-min",
        type=float,
        default=10.0,
        help="Minimum CSI SNR for TDM tensor construction.",
    )

    capture_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Run complete orchestration without starting RF acquisition.",
    )

    capture_parser.add_argument(
        "--no-remote-tx",
        action="store_true",
        help="Do not start/stop TX remotely. Use an externally managed TX.",
    )

    capture_parser.add_argument(
        "--tx-interval-ms",
        type=int,
        default=100,
        help="Remote TX packet interval in ms. Default: 100.",
    )


    scan_parser = sub.add_parser(
        "scan",
        help=(
            "Run interactive multi-view "
            "manual-step CSI sensing."
        ),
    )

    scan_parser.add_argument(
        "session_name",
        help=(
            "Logical multi-view experiment name, "
            "e.g. room01."
        ),
    )

    scan_parser.add_argument(
        "--trajectory",
        default="manual_step",
        help=(
            "Trajectory config name. "
            "Default: manual_step."
        ),
    )

    scan_parser.add_argument(
        "--duration",
        type=float,
        default=None,
        help=(
            "Capture duration per view in seconds."
        ),
    )

    scan_parser.add_argument(
        "--snr-min",
        type=float,
        default=10.0,
        help=(
            "Minimum CSI SNR for TDM tensor."
        ),
    )

    scan_parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "Exercise multi-view orchestration "
            "without RF acquisition."
        ),
    )

    scan_parser.add_argument(
        "--no-remote-tx",
        action="store_true",
        help=(
            "Do not control TX remotely."
        ),
    )

    scan_parser.add_argument(
        "--tx-interval-ms",
        type=int,
        default=100,
        help=(
            "Remote TX packet interval in ms."
        ),
    )

    args = parser.parse_args()

    if args.command == "doctor":
        sys.exit(doctor())

    if args.command == "status":
        status()
        return

    if args.command == "config":
        show_config()
        return

    if args.command == "capture":

        if args.prepare:
            sys.exit(
                prepare_capture(
                    args.session_name,
                    mode=args.mode,
                    trajectory=args.trajectory,
                )
            )

        sys.exit(
            capture_session(
                args.session_name,
                mode=args.mode,
                trajectory=args.trajectory,
                duration_s=args.duration,
                snr_min=args.snr_min,
                dry_run=args.dry_run,
                remote_tx=not args.no_remote_tx,
                tx_interval_ms=args.tx_interval_ms,
            )
        )

    if args.command == "scan":

        sys.exit(
            scan_session(
                args.session_name,
                trajectory=args.trajectory,
                duration_s=args.duration,
                snr_min=args.snr_min,
                dry_run=args.dry_run,
                remote_tx=not args.no_remote_tx,
                tx_interval_ms=args.tx_interval_ms,
            )
        )


if __name__ == "__main__":
    main()
